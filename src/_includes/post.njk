---
layout: base
---
<nav class="breadcrumb">
  <a href="{% if locale == 'pt' %}/pt-br/{% else %}/{% endif %}">{{ 'home' | i18n(locale) }}</a> &rsaquo;
  <a href="{% if locale == 'pt' %}/pt-br/posts/{% else %}/posts/{% endif %}">{{ 'posts' | i18n(locale) }}</a>
</nav>

<h1 class="post-title">{{ title }}</h1>

<p class="post-meta">
  {{ 'published' | i18n(locale) }} {{ date | readableDate(locale) }}
  {% if updated %}<br>{{ 'lastUpdated' | i18n(locale) }} {{ updated | readableDate(locale) }}{% endif %}
</p>

<article>
{{ content | safe }}
</article>

<hr>
<footer class="post-footer">
  Paulo Henrique Cuchi
  <a href="https://creativecommons.org/licenses/by/3.0/" target="_blank" rel="noopener noreferrer">
    <img src="/assets/images/cc-by.png" alt="CC-BY" class="cc-by-icon" width="64" height="28">
  </a>
</footer>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "{{ title }}",
  "url": "{{ metadata.url }}{{ page.url }}",
  "datePublished": "{{ date | dateToRfc3339 }}",
  {% if updated %}"dateModified": "{{ updated | dateToRfc3339 }}",{% endif %}
  "author": {
    "@type": "Person",
    "name": "Paulo Henrique Cuchi",
    "url": "{{ metadata.url }}"
  },
  "publisher": {
    "@type": "Person",
    "name": "Paulo Henrique Cuchi"
  },
  "description": "{{ description or title }}"
}
</script>
