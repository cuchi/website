---
layout: base
---
<nav class="breadcrumb">
  <a href="/">Home</a> &rsaquo;
  <a href="/posts">Posts</a> &rsaquo;
  <strong>{{ title }}</strong>
</nav>

<p class="post-meta">
  Published {{ date | readableDate }}
  {% if updated %}<br>Last updated {{ updated | readableDate }}{% endif %}
</p>

<article>
{{ content | safe }}
</article>

<hr>
<footer class="post-footer">
  Paulo Henrique Cuchi
  <a href="https://creativecommons.org/licenses/by/3.0/" target="_blank" rel="noopener noreferrer">
    <img src="/assets/images/cc-by.png" alt="CC-BY" class="cc-by-icon" width="64" height="28">
  </a>
</footer>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "{{ title }}",
  "url": "{{ metadata.url }}{{ page.url }}",
  "datePublished": "{{ date | dateToRfc3339 }}",
  {% if updated %}"dateModified": "{{ updated | dateToRfc3339 }}",{% endif %}
  "author": {
    "@type": "Person",
    "name": "Paulo Henrique Cuchi",
    "url": "{{ metadata.url }}"
  },
  "publisher": {
    "@type": "Person",
    "name": "Paulo Henrique Cuchi"
  },
  "description": "{{ description or title }}"
}
</script>
