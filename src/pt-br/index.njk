---
layout: base
permalink: /pt-br/index.html
description: "Paulo Henrique Cuchi — engenheiro de software. Reflexões sobre backend, Rust, DevOps e ferramentas Unix."
---

<header>
  <h1>Paulo Henrique Cuchi</h1>

  <p class="cv-download">
    <a href="/Paulo-Henrique-Cuchi.pdf" download>{{ 'downloadCV' | i18n(locale) }}</a>
  </p>

  <blockquote>
    <em>{{ 'intro' | i18n(locale) }}</em>
  </blockquote>
</header>

<main>
  <section>
    <h2>{{ 'thingsILike' | i18n(locale) }}</h2>
    <ul>
    {% for item in i18n[locale].likes %}
      <li>{{ item }}</li>
    {% endfor %}
    </ul>
  </section>

  <section>
    <h2>{{ 'posts' | i18n(locale) }}</h2>
    <ul>
    {% for post in collections.postsPt | reverse %}
      <li>
        <a href="{{ post.url }}">{{ post.data.title }}</a>
        — <span class="date-detail">{{ post.date | readableDate(locale) }}</span>
      </li>
    {% endfor %}
    </ul>
  </section>

  <section>
    <h2>{{ 'career' | i18n(locale) }}</h2>
    <div class="career-timeline">
    {% for event in career %}
      <div class="career-item"{% if event.isCurrent %} data-current{% endif %}>
        <div class="career-meta">
          {{ event.displayBegin }} – {{ event.displayEnd }} · <span class="career-duration">{{ event.duration }}</span>
        </div>
        <div class="career-card">
          <div class="career-header">
            {% if event.logoUrl %}
            <img src="{{ event.logoUrl }}" alt="{{ event.where }}" class="career-logo" loading="lazy">
            {% endif %}
            <div>
              <strong>{{ event.where }}</strong>
              <div>{% if locale == 'pt' %}{{ event.titlePt or event.title }}{% else %}{{ event.title }}{% endif %} · {{ i18n[locale].careerTypes[event.type] or event.type }}</div>
            </div>
          </div>
          {% set acts = (locale == 'pt' and event.activitiesPt) or event.activities %}
          {% if acts and acts.length %}
          <ul class="career-activities">
          {% for activity in acts %}
            <li>{{ activity }}</li>
          {% endfor %}
          </ul>
          {% endif %}
        </div>
      </div>
    {% endfor %}
    </div>
  </section>

</main>

<footer class="site-footer">
  <div class="social-links">
    <a href="https://github.com/cuchi" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="GitHub">
      <svg class="social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
      </svg>
    </a>
    <a href="https://www.linkedin.com/in/pcuchi/" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn">
      <svg class="social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
        <rect x="2" y="9" width="4" height="12"/>
        <circle cx="4" cy="4" r="2"/>
      </svg>
    </a>
    <a href="/rss.xml" class="social-link" aria-label="RSS">
      <svg class="social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 11a9 9 0 0 1 9 9"/>
        <path d="M4 4a16 16 0 0 1 16 16"/>
        <circle cx="5" cy="19" r="1"/>
      </svg>
    </a>
  </div>
  <p class="footer-text">
    {{ 'footer' | i18n(locale) }}
    <a href="https://github.com/cuchi/website" target="_blank" rel="noopener noreferrer">{{ 'viewSource' | i18n(locale) }}</a>
  </p>
</footer>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Paulo Henrique Cuchi",
  "url": "{{ metadata.url }}",
  "sameAs": [
    "https://github.com/cuchi",
    "https://www.linkedin.com/in/pcuchi/"
  ],
  "jobTitle": "Software Engineer",
  "knowsAbout": ["Backend Development", "DevOps", "Rust", "Unix"]
}
</script>
